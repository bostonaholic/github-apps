# Copy to .env and fill in after registering the app.
# Leave empty and run `npm start` to use Probot's setup flow instead.
APP_ID=
WEBHOOK_SECRET=
PRIVATE_KEY=
# For local development: a channel from https://smee.io/new
WEBHOOK_PROXY_URL=
# For the install-task-list-completed skill: API management of the
# installation's repo selection. Reads take the app's user token (mint via
# device flow with GITHUB_CLIENT_ID); writes take a classic PAT with repo
# scope. See the skill for details.
GITHUB_CLIENT_ID=
GITHUB_APP_USER_TOKEN=
GITHUB_PAT=
