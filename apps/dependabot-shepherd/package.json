{
  "name": "dependabot-shepherd",
  "version": "0.1.1",
  "private": true,
  "description": "GitHub App that approves, auto-merges, and rebases Dependabot PRs per policy",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "^20.18.1 || >=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "probot run ./lib/index.js",
    "test": "vitest run",
    "test:e2e": "bash e2e.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "probot": "^14.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "smee-client": "^5.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
